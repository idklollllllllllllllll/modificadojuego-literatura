                window.print()
            }
            function showTeacherLogin() {
                showSection("teacherLogin")
            }
            function getPin() {
                return localStorage.getItem("fl_pin") || "2026"
            }
            function enterTeacher() {
                if (document.getElementById("teacherPin").value !== getPin())
                    return alert("PIN incorrecto.");
                showSection("teacher");
                renderBank()
            }
            function teacherTab(tab, btn) {
                document.querySelectorAll(".tab").forEach(x => x.classList.remove("active"));
                btn.classList.add("active");
                ["teacherBank", "teacherStudents", "teacherSettings"].forEach(x => document.getElementById(x).classList.add("hidden"));
                if (tab === "bank") {
                    document.getElementById("teacherBank").classList.remove("hidden");
                    renderBank()
                }
                if (tab === "students") {
                    document.getElementById("teacherStudents").classList.remove("hidden");
                    renderStudents()
                }
                if (tab === "settings")
                    document.getElementById("teacherSettings").classList.remove("hidden")
            }
            function renderBank() {
                document.getElementById("bankRows").innerHTML = questions.map( (q, i) => `<tr><td>${q.id}</td><td>${q.level}</td><td>${q.figure}</td><td>${q.prompt}</td><td>${q.answer}</td><td><button class="secondary" onclick="editQuestion(${i})">Editar</button></td></tr>`).join("")
            }
            function editQuestion(i) {
                editIndex = i;
                let q = questions[i];
                showSection("editQ");
                document.getElementById("editId").textContent = q.id;
                document.getElementById("editPrompt").value = q.prompt;
                document.getElementById("editA").value = q.options[0] || "";
                document.getElementById("editB").value = q.options[1] || "";
                document.getElementById("editC").value = q.options[2] || "";
                document.getElementById("editAnswer").value = q.answer;
                document.getElementById("editHint").value = q.hint;
                document.getElementById("editExplanation").value = q.explanation
            }
            function saveEdit() {
                let q = questions[editIndex]
                  , opts = [document.getElementById("editA").value.trim(), document.getElementById("editB").value.trim(), document.getElementById("editC").value.trim()].filter(Boolean)
                  , ans = document.getElementById("editAnswer").value.trim();
                if (!opts.includes(ans))
                    return alert("La respuesta correcta debe coincidir exactamente con una alternativa.");
                q.prompt = document.getElementById("editPrompt").value.trim();
                q.options = opts;
                q.answer = ans;
                q.hint = document.getElementById("editHint").value.trim();
                q.explanation = document.getElementById("editExplanation").value.trim();
                localStorage.setItem("fl_questions", JSON.stringify(questions));
                showSection("teacher");
                renderBank()
            }
            function renderStudents() {
                let u = Object.values(users());
                document.getElementById("teacherStudents").innerHTML = u.length ? `<div class="tablewrap"><table><tr><th>Estudiante</th><th>Progreso</th><th>Correctas</th><th>Logro</th><th>Monedas</th><th>Última actividad</th></tr>${u.map(s => `<tr><td>${s.name}</td><td>${s.done}/100</td><td>${s.correct}</td><td>${s.done ? Math.round(s.correct / s.done * 100) : 0}%</td><td>${s.coins}</td><td>${new Date(s.last).toLocaleString()}</td></tr>`).join("")}</table></div>` : `<div class='notice'>Aún no hay estudiantes registrados en este computador.</div>`
            }
            function changePin() {
                let p = document.getElementById("newPin").value.trim();
                if (p.length < 4)
                    return alert("Usa un PIN de al menos 4 caracteres.");
                localStorage.setItem("fl_pin", p);
                document.getElementById("newPin").value = "";
                alert("PIN actualizado.")
            }
            showSection("login");
        </script>
    </body>
</html>
