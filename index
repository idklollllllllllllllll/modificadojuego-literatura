<!DOCTYPE html>
<html lang="es">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Aventura de las Figuras Literarias - 5.º Básico</title>
        <style>
            :root {
                --bg: #f5f7fb;
                --panel: #ffffff;
                --ink: #24324a;
                --muted: #667085;
                --accent: #6c63ff;
                --accent2: #ffb703;
                --good: #198754;
                --bad: #c2410c;
                --line: #dfe3ea;
                --shadow: 0 14px 40px rgba(40,48,80,.12)
            }

            * {
                box-sizing: border-box
            }

            body {
                margin: 0;
                font-family: Inter,system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;
                background: linear-gradient(135deg,#eef2ff,#fff7ed);
                color: var(--ink)
            }

            button,input,select,textarea {
                font: inherit
            }

            button {
                cursor: pointer;
                border: 0;
                border-radius: 16px;
                padding: 13px 18px;
                font-weight: 800
            }

            .wrap {
                max-width: 1180px;
                margin: 0 auto;
                padding: 24px
            }

            .card {
                background: rgba(255,255,255,.96);
                border: 1px solid var(--line);
                border-radius: 24px;
                box-shadow: var(--shadow);
                padding: 24px
            }

            .hidden {
                display: none!important
            }

            .topbar {
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 16px;
                margin-bottom: 18px
            }

            .brand h1 {
                margin: 0;
                font-size: clamp(24px,3vw,38px)
            }

            .small {
                color: var(--muted);
                font-size: 14px
            }

            .pill {
                background: #fff;
                border: 1px solid var(--line);
                padding: 9px 13px;
                border-radius: 999px;
                font-weight: 800
            }

            .grid {
                display: grid;
                grid-template-columns: 1.1fr .9fr;
                gap: 22px
            }

            @media(max-width: 800px) {
                .grid {
                    grid-template-columns:1fr
                }

                .topbar {
                    align-items: flex-start;
                    flex-direction: column
                }
            }

            .primary {
                background: var(--accent);
                color: white
            }

            .secondary {
                background: #eef2ff;
                color: #3730a3
            }

            .gold {
                background: #fff3cd;
                color: #7a5b00
            }

            .danger {
                background: #fee2e2;
                color: #991b1b
            }

            .btnrow {
                display: flex;
                flex-wrap: wrap;
                gap: 10px
            }

            .hero {
                display: flex;
                align-items: center;
                gap: 24px;
                flex-wrap: wrap
            }

            .mascotWrap {
                min-width: 240px;
                text-align: center
            }

            .mascot {
                width: 170px;
                height: 180px;
                margin: auto;
                position: relative;
                filter: drop-shadow(0 18px 18px rgba(0,0,0,.12))
            }

            .bodyBlob {
                position: absolute;
                inset: 24px 18px 14px;
                border-radius: 48% 48% 42% 42%;
                background: linear-gradient(145deg,#8b8cff,#5f61e6);
                box-shadow: inset 16px 16px 22px rgba(255,255,255,.24),inset -12px -12px 20px rgba(0,0,0,.10)
            }

            .eye {
                position: absolute;
                top: 65px;
                width: 18px;
                height: 23px;
                background: white;
                border-radius: 50%;
                z-index: 3
            }

            .eye:after {
                content: "";
                position: absolute;
                left: 6px;
                top: 8px;
                width: 7px;
                height: 9px;
                background: #1f2937;
                border-radius: 50%
            }

            .e1 {
                left: 57px
            }

            .e2 {
                right: 57px
            }

            .mouth {
                position: absolute;
                left: 70px;
                top: 104px;
                width: 30px;
                height: 16px;
                border-bottom: 5px solid #26334a;
                border-radius: 50%;
                z-index: 3
            }

            .acc {
                position: absolute;
                z-index: 6;
                font-size: 38px;
                display: none
            }

            .hat {
                top: -2px;
                left: 61px
            }

            .glasses {
                top: 62px;
                left: 46px
            }

            .shirt {
                top: 116px;
                left: 64px
            }

            .shoes {
                bottom: -2px;
                left: 49px
            }

            .bag {
                top: 105px;
                right: 10px
            }

            .show {
                display: block
            }

            .progress {
                height: 16px;
                background: #e5e7eb;
                border-radius: 999px;
                overflow: hidden
            }

            .progress>div {
                height: 100%;
                background: linear-gradient(90deg,#6c63ff,#9d4edd);
                width: 0
            }

            .statgrid {
                display: grid;
                grid-template-columns: repeat(4,1fr);
                gap: 10px;
                margin: 16px 0
            }

            .stat {
                background: #f8fafc;
                border: 1px solid var(--line);
                border-radius: 16px;
                padding: 12px;
                text-align: center
            }

            .stat b {
                display: block;
                font-size: 22px
            }

            @media(max-width: 650px) {
                .statgrid {
                    grid-template-columns:repeat(2,1fr)
                }
            }

            .option {
                display: block;
                width: 100%;
                text-align: left;
                background: white;
                border: 2px solid var(--line);
                margin: 10px 0;
                padding: 16px;
                border-radius: 16px
            }

            .option:hover {
                border-color: #aaa5ff
            }

            .option.correct {
                border-color: #22c55e;
                background: #ecfdf5
            }

            .option.wrong {
                border-color: #fb923c;
                background: #fff7ed
            }

            .qnum {
                font-size: 13px;
                color: var(--muted);
                font-weight: 800;
                text-transform: uppercase;
                letter-spacing: .08em
            }

            .question {
                font-size: 24px;
                line-height: 1.35;
                margin: 8px 0 18px;
                font-weight: 900
            }

            .notice {
                padding: 14px;
                border-radius: 14px;
                margin: 12px 0;
                background: #f8fafc;
                border: 1px solid var(--line)
            }

            .tabs {
                display: flex;
                gap: 8px;
                flex-wrap: wrap;
                margin-bottom: 14px
            }

            .tab {
                background: #eef2ff;
                color: #3730a3
            }

            .tab.active {
                background: var(--accent);
                color: white
            }

            .shopgrid {
                display: grid;
                grid-template-columns: repeat(auto-fit,minmax(160px,1fr));
                gap: 12px
            }

            .shopitem {
                border: 1px solid var(--line);
                border-radius: 18px;
                padding: 15px;
                background: #fff;
                text-align: center
            }

            .shopitem .emoji {
                font-size: 42px
            }

            input,textarea,select {
                width: 100%;
                border: 1px solid var(--line);
                border-radius: 12px;
                padding: 11px;
                background: white
            }

            .field {
                margin: 12px 0
            }

            .field label {
                display: block;
                font-weight: 800;
                margin-bottom: 6px
            }

            table {
                width: 100%;
                border-collapse: collapse;
                font-size: 14px
            }

            th,td {
                padding: 10px;
                border-bottom: 1px solid var(--line);
                text-align: left;
                vertical-align: top
            }

            th {
                background: #f8fafc;
                position: sticky;
                top: 0
            }

            .tablewrap {
                max-height: 520px;
                overflow: auto;
                border: 1px solid var(--line);
                border-radius: 16px
            }

            footer {
                text-align: center;
                color: var(--muted);
                padding: 24px 0
            }
        </style>
    </head>
    <body>
        <div class="wrap">
            <div class="topbar">
                <div class="brand">
                    <h1>📚 Aventura de las Figuras Literarias</h1>
                    <div class="small">5.º Básico · Profesora Diferencial: Daniela Rocha Villalobos</div>
                </div>
                <div class="btnrow">
                    <span class="pill" id="coinPill">🪙 0</span>
                    <button class="secondary" onclick="showTeacherLogin()">🔐 Modo Profesor</button>
                </div>
            </div>
            <section id="login" class="card">
                <div class="grid">
                    <div>
                        <h2>¡Bienvenido a tu aventura!</h2>
                        <p>Escribe tu nombre de usuario. Tu avance quedará guardado en este computador.</p>
                        <div class="field">
                            <label>Nombre de usuario</label>
                            <input id="username" maxlength="30" placeholder="Ej.: Martina R.">
                        </div>
                        <button class="primary" onclick="startUser()">COMENZAR MI AVENTURA</button>
                    </div>
                    <div class="mascotWrap">
                        <div class="mascot">
                            <div class="bodyBlob"></div>
                            <div class="eye e1"></div>
                            <div class="eye e2"></div>
                            <div class="mouth"></div>
                        </div>
                        <b>Tu mascota te acompañará durante todo el juego.</b>
                    </div>
                </div>
            </section>
            <section id="home" class="hidden">
                <div class="grid">
                    <div class="card">
                        <h2 id="hello">Hola</h2>
                        <div class="progress">
                            <div id="progressBar"></div>
                        </div>
                        <div class="statgrid">
                            <div class="stat">
                                <b id="doneStat">0</b>
                                realizadas
                            </div>
                            <div class="stat">
                                <b id="correctStat">0</b>
                                correctas
                            </div>
                            <div class="stat">
                                <b id="percentStat">0%</b>
                                logro
                            </div>
                            <div class="stat">
                                <b id="coinsStat">0</b>
                                monedas
                            </div>
                        </div>
                        <div class="btnrow">
                            <button class="primary" onclick="openReview()">📖 Repaso inicial</button>
                            <button class="primary" onclick="continueGame()">▶️ Continuar aventura</button>
                            <button class="gold" onclick="openShop()">🛍️ Tienda</button>
                            <button class="secondary" onclick="openCloset()">👕 Mi armario</button>
                            <button class="secondary" onclick="openReport()">📊 Mi informe</button>
                            <button class="danger" onclick="logout()">Salir</button>
                        </div>
                    </div>
                    <div class="card mascotWrap">
                        <div class="mascot" id="homeMascot">
                            <div class="bodyBlob"></div>
                            <div class="eye e1"></div>
                            <div class="eye e2"></div>
                            <div class="mouth"></div>
                            <div class="acc hat">🎩</div>
                            <div class="acc glasses">🤓</div>
                            <div class="acc shirt">👕</div>
                            <div class="acc shoes">👟</div>
                            <div class="acc bag">🎒</div>
                        </div>
                        <h3>Mi mascota</h3>
                        <div class="small">Desbloquea accesorios con tus Monedas Literarias.</div>
                    </div>
                </div>
            </section>
            <section id="review" class="card hidden">
                <h2>📖 Repaso de las 6 figuras literarias</h2>
                <div id="reviewCards"></div>
                <div class="btnrow">
                    <button class="primary" onclick="finishReview()">TERMINÉ EL REPASO</button>
                    <button class="secondary" onclick="goHome()">Volver</button>
                </div>
            </section>
            <section id="game" class="card hidden">
                <div class="qnum" id="qMeta"></div>
                <div class="question" id="qPrompt"></div>
                <div id="options"></div>
                <div id="feedback" class="notice hidden"></div>
                <div class="btnrow">
                    <button class="secondary" onclick="showHint()">💡 Ver pista</button>
                    <button class="secondary" onclick="goHome()">Guardar y salir</button>
                    <button id="nextBtn" class="primary hidden" onclick="nextQuestion()">Siguiente</button>
                </div>
            </section>
            <section id="shop" class="card hidden">
                <h2>🛍️ Tienda de la mascota</h2>
                <p>
                    Tus monedas: <b id="shopCoins">0</b>
                    . Lo que compras queda desbloqueado para siempre.
                </p>
                <div class="shopgrid" id="shopGrid"></div>
                <br>
                <button class="secondary" onclick="goHome()">Volver</button>
            </section>
            <section id="closet" class="card hidden">
                <h2>👕 Mi armario</h2>
                <div class="grid">
                    <div>
                        <div class="shopgrid" id="closetGrid"></div>
                    </div>
                    <div class="mascotWrap">
                        <div class="mascot" id="closetMascot">
                            <div class="bodyBlob"></div>
                            <div class="eye e1"></div>
                            <div class="eye e2"></div>
                            <div class="mouth"></div>
                            <div class="acc hat">🎩</div>
                            <div class="acc glasses">🤓</div>
                            <div class="acc shirt">👕</div>
                            <div class="acc shoes">👟</div>
                            <div class="acc bag">🎒</div>
                        </div>
                    </div>
                </div>
                <br>
                <button class="secondary" onclick="goHome()">Volver</button>
            </section>
            <section id="report" class="card hidden">
                <h2>📊 Informe de aprendizaje</h2>
                <div id="reportBody"></div>
                <div class="btnrow">
                    <button class="primary" onclick="printReport()">🖨️ Imprimir / Guardar como PDF</button>
                    <button class="secondary" onclick="goHome()">Volver</button>
                </div>
            </section>
            <section id="teacherLogin" class="card hidden">
                <h2>🔐 Modo Profesor</h2>
                <p>
                    PIN inicial: <b>2026</b>
                    . Puedes cambiarlo dentro del panel.
                </p>
                <div class="field">
                    <label>PIN</label>
                    <input id="teacherPin" type="password">
                </div>
                <div class="btnrow">
                    <button class="primary" onclick="enterTeacher()">Entrar</button>
                    <button class="secondary" onclick="showSection('login')">Cancelar</button>
                </div>
            </section>
            <section id="teacher" class="card hidden">
                <h2>👩‍🏫 Modo Profesor</h2>
                <div class="tabs">
                    <button class="tab active" onclick="teacherTab('bank',this)">Banco de preguntas</button>
                    <button class="tab" onclick="teacherTab('students',this)">Estudiantes de este computador</button>
                    <button class="tab" onclick="teacherTab('settings',this)">Configuración</button>
                </div>
                <div id="teacherBank">
                    <p>Revisa las 100 preguntas. Puedes editar enunciado, alternativas, respuesta, pista y explicación. Los cambios quedan guardados localmente.</p>
                    <div class="tablewrap">
                        <table>
                            <thead>
                                <tr>
                                    <th>Nº</th>
                                    <th>Nivel</th>
                                    <th>Figura</th>
                                    <th>Pregunta</th>
                                    <th>Respuesta</th>
                                    <th>Acción</th>
                                </tr>
                            </thead>
                            <tbody id="bankRows"></tbody>
                        </table>
                    </div>
                </div>
                <div id="teacherStudents" class="hidden"></div>
                <div id="teacherSettings" class="hidden">
                    <div class="field">
                        <label>Nuevo PIN</label>
                        <input id="newPin" maxlength="12">
                    </div>
                    <button class="primary" onclick="changePin()">Guardar PIN</button>
                    <div class="notice">Esta versión guarda todo en el navegador de cada computador. No sincroniza todavía los 45 equipos entre sí.</div>
                </div>
                <br>
                <button class="secondary" onclick="showSection('login')">Salir del Modo Profesor</button>
            </section>
            <section id="editQ" class="card hidden">
                <h2>
                    Editar pregunta <span id="editId"></span>
                </h2>
                <div class="field">
                    <label>Enunciado</label>
                    <textarea id="editPrompt"></textarea>
                </div>
                <div class="field">
                    <label>Alternativa A</label>
                    <input id="editA">
                </div>
                <div class="field">
                    <label>Alternativa B</label>
                    <input id="editB">
                </div>
                <div class="field">
                    <label>Alternativa C</label>
                    <input id="editC">
                </div>
                <div class="field">
                    <label>Respuesta correcta (debe coincidir exactamente con una alternativa)</label>
                    <input id="editAnswer">
                </div>
                <div class="field">
                    <label>Pista</label>
                    <input id="editHint">
                </div>
                <div class="field">
                    <label>Explicación</label>
                    <textarea id="editExplanation"></textarea>
                </div>
                <div class="btnrow">
                    <button class="primary" onclick="saveEdit()">Guardar cambios</button>
                    <button class="secondary" onclick="showSection('teacher');renderBank()">Cancelar</button>
                </div>
            </section>
            <footer>Juego educativo para 5.º Básico · Sin audio · Diseñado para uso con mouse</footer>
        </div>
        <script>
            const DEFAULT_QUESTIONS = [{
                "id": 1,
                "level": 1,
                "figure": "Comparación",
                "prompt": "¿Qué figura literaria aparece en “Tus ojos brillan como estrellas”?",
                "options": ["Comparación", "Metáfora", "Onomatopeya"],
                "answer": "Comparación",
                "hint": "Busca una palabra que compare, como “como”.",
                "explanation": "Compara los ojos con estrellas usando “como”."
            }, {
                "id": 2,
                "level": 1,
                "figure": "Metáfora",
                "prompt": "¿Qué figura literaria aparece en “Tus ojos son dos estrellas”?",
                "options": ["Metáfora", "Comparación", "Hipérbole"],
                "answer": "Metáfora",
                "hint": "Una cosa se presenta como si fuera otra, sin usar “como”.",
                "explanation": "Los ojos se presentan directamente como estrellas."
            }, {
                "id": 3,
                "level": 1,
                "figure": "Personificación",
                "prompt": "¿Qué figura literaria aparece en “El viento cantaba en la ventana”?",
                "options": ["Personificación", "Onomatopeya", "Aliteración"],
                "answer": "Personificación",
                "hint": "Piensa si algo no humano realiza una acción humana.",
                "explanation": "Al viento se le atribuye la acción humana de cantar."
            }, {
                "id": 4,
                "level": 1,
                "figure": "Hipérbole",
                "prompt": "¿Qué figura literaria aparece en “Te esperé un millón de años”?",
                "options": ["Hipérbole", "Metáfora", "Comparación"],
                "answer": "Hipérbole",
                "hint": "Busca una exageración evidente.",
                "explanation": "Esperar un millón de años es una exageración."
            }, {
                "id": 5,
                "level": 1,
                "figure": "Onomatopeya",
                "prompt": "¿Qué figura literaria aparece en “¡Pum! cayó el libro”?",
                "options": ["Onomatopeya", "Personificación", "Comparación"],
                "answer": "Onomatopeya",
                "hint": "Busca una palabra que imite un sonido.",
                "explanation": "“Pum” imita el sonido de una caída o golpe."
            }, {
                "id": 6,
                "level": 1,
                "figure": "Aliteración",
                "prompt": "¿Qué figura literaria aparece en “Mi mamá me mima mucho”?",
                "options": ["Aliteración", "Hipérbole", "Metáfora"],
                "answer": "Aliteración",
                "hint": "Fíjate si se repite mucho un mismo sonido.",
                "explanation": "Se repite varias veces el sonido /m/."
            }, {
                "id": 7,
                "level": 1,
                "figure": "Comparación",
                "prompt": "¿Cuál oración contiene una comparación?",
                "options": ["Corre como un rayo.", "El sol me saludó.", "¡Ring, ring! sonó el teléfono."],
                "answer": "Corre como un rayo.",
                "hint": "Busca una comparación explícita.",
                "explanation": "“Como un rayo” compara la velocidad."
            }, {
                "id": 8,
                "level": 1,
                "figure": "Metáfora",
                "prompt": "¿Cuál oración contiene una metáfora?",
                "options": ["Su cabello es oro.", "Su cabello brilla como oro.", "El cabello baila con el viento."],
                "answer": "Su cabello es oro.",
                "hint": "No debe aparecer “como”.",
                "explanation": "El cabello se identifica directamente con el oro."
            }, {
                "id": 9,
                "level": 1,
                "figure": "Personificación",
                "prompt": "¿Cuál oración contiene personificación?",
                "options": ["Las hojas bailaban felices.", "Las hojas eran verdes.", "Las hojas caían como plumas."],
                "answer": "Las hojas bailaban felices.",
                "hint": "¿Las hojas pueden bailar de verdad?",
                "explanation": "Se atribuye a las hojas una acción humana."
            }, {
                "id": 10,
                "level": 1,
                "figure": "Hipérbole",
                "prompt": "¿Cuál oración contiene una hipérbole?",
                "options": ["Tengo tanta hambre que comería una montaña.", "Tengo hambre.", "Como pan con queso."],
                "answer": "Tengo tanta hambre que comería una montaña.",
                "hint": "Busca una exageración imposible o muy grande.",
                "explanation": "Comer una montaña exagera el hambre."
            }, {
                "id": 11,
                "level": 1,
                "figure": "Onomatopeya",
                "prompt": "¿Cuál palabra es una onomatopeya?",
                "options": ["Miau", "Gato", "Peludo"],
                "answer": "Miau",
                "hint": "Piensa en un sonido de animal.",
                "explanation": "“Miau” imita el sonido del gato."
            }, {
                "id": 12,
                "level": 1,
                "figure": "Aliteración",
                "prompt": "¿Cuál frase usa repetición de sonidos?",
                "options": ["Paco pica poca papa.", "El perro duerme.", "La luna parece queso."],
                "answer": "Paco pica poca papa.",
                "hint": "Escucha mentalmente el sonido inicial.",
                "explanation": "Se repite el sonido /p/."
            }, {
                "id": 13,
                "level": 1,
                "figure": "Comparación",
                "prompt": "Completa: “La nieve es blanca _ el algodón”.",
                "options": ["como", "porque", "aunque"],
                "answer": "como",
                "hint": "¿Qué palabra suele introducir una comparación?",
                "explanation": "“Como” establece la comparación."
            }, {
                "id": 14,
                "level": 1,
                "figure": "Metáfora",
                "prompt": "¿Cuál opción es una metáfora?",
                "options": ["La luna es un farol.", "La luna parece un farol.", "La luna ilumina."],
                "answer": "La luna es un farol.",
                "hint": "Busca una identificación directa.",
                "explanation": "La luna se presenta como un farol."
            }, {
                "id": 15,
                "level": 1,
                "figure": "Personificación",
                "prompt": "“La ciudad nunca duerme” es un ejemplo de…",
                "options": ["Personificación", "Hipérbole", "Onomatopeya"],
                "answer": "Personificación",
                "hint": "Dormir es una acción de seres vivos.",
                "explanation": "Se atribuye a la ciudad la capacidad de dormir."
            }, {
                "id": 16,
                "level": 1,
                "figure": "Hipérbole",
                "prompt": "“Lloré un río entero” es un ejemplo de…",
                "options": ["Hipérbole", "Comparación", "Aliteración"],
                "answer": "Hipérbole",
                "hint": "¿Es literalmente posible llorar un río?",
                "explanation": "Es una exageración para expresar mucho llanto."
            }, {
                "id": 17,
